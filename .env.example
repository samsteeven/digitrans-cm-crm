# DIGITRANS-CM CRM - Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs

# Base de donnees PostgreSQL
DB_PASSWORD=secret

# Redis
REDIS_PASSWORD=secret

# AWS (deploiement af-south-1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1

# Application
APP_ENV=local
APP_DEBUG=true
