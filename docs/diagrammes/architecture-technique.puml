@startuml
!theme plain

title Architecture Technique — CRM SavoirManger (DIGITRANS-CM)

skinparam component {
  BackgroundColor #FEFEFE
  BorderColor #333
  FontSize 12
}

skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}

skinparam node {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}

skinparam rectangle {
  BackgroundColor #FFF3E0
  BorderColor #E65100
  FontSize 11
}

skinparam cloud {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}

' ── CLIENTS ──
cloud "Clients\n(Navigateur / PWA)" as clients {
  rectangle "React 18\n(Vite + TailwindCSS)" as react
  rectangle "Service Worker\n(Workbox)" as sw
  rectangle "IndexedDB\n(Offline)" as idb
}

rectangle "Frontend\n(React SPA)" as frontend {
  rectangle "Pages\n(7 pages)" as pages
  rectangle "Stores\n(Zustand)" as stores
  rectangle "Hooks\n(React Query)" as hooks
  rectangle "Router\n(React Router)" as router
}

rectangle "Backend\n(Laravel 13 API)" as backend {
  rectangle "Controleurs\n(10 controleurs)" as controllers
  rectangle "Middlewares\n(Sanctum / CORS\n RateLimiter)" as middlewares
  rectangle "Cache\n(Redis)" as cache
  rectangle "Queue\n(Horizon)" as queue
}

database "PostgreSQL 16\n(Base de donnees)" as db {
  rectangle "22 tables\n+ 1 vue materialisee" as tables
  rectangle "KPI\n(Agregations)" as kpi
}

rectangle "Monitoring" as monitoring {
  rectangle "Prometheus\n(Metriques)" as prometheus
  rectangle "Grafana\n(Dashboards)" as grafana
}

rectangle "CI/CD\n(GitHub Actions)" as cicd {
  rectangle "Tests\n(PHPUnit / Vitest)" as tests
  rectangle "Scan\n(Trivy)" as scan
  rectangle "Docker\n(Build & Push)" as docker
  rectangle "Deploy\n(Staging / Prod)" as deploy
}

cloud "AWS af-south-1\n(Cape Town)" as aws {
  rectangle "EC2\n(Staging)" as staging
  rectangle "EC2\n(Production)" as production
}

' ── FLUX ──
clients --> frontend : HTTPS\n(port 3000)
frontend --> backend : HTTP Proxy\n(Vite /api/*)
backend --> db : PostgreSQL\n(port 5432)
backend --> cache : Redis\n(port 6379)

backend --> monitoring : /api/metrics
monitoring --> aws : Scraping

frontend ..> sw : Cache API\n(CacheFirst / NetworkFirst)
sw ..> idb : Offline\n(IndexedDB)
idb ..> backend : Sync\n(/api/v1/sync)

cicd ..> docker : ghcr.io\n(Container Registry)
cicd ..> tests : php artisan test\n& npm test
docker ..> staging : docker compose\nup -d
docker ..> production : docker compose\nup -d

' ── LEGENDE ──
legend right
  | Couleur | Type |
  |---|---|
  | <#E3F2FD> | Infrastructure |
  | <#E8F5E9> | Base de donnees |
  | <#FFF3E0> | Application |
  | <#F3E5F2> | Reseau / Cloud |
endlegend

@enduml
